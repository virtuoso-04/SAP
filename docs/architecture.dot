digraph G {
    rankdir=LR;
    
    subgraph cluster_frontend {
        label="Frontend (React)";
        style=filled;
        color=lightgrey;
        node [style=filled,color=white];
        
        Components [label="Components\n(Header, Registration Form, QR Code, etc.)"];
        Pages [label="Pages\n(Landing, Dashboard, Admin, etc.)"];
        Router [label="React Router"];
        APIService [label="API Service"];
        
        Components -> Pages;
        Pages -> Router;
        Pages -> APIService;
    }
    
    subgraph cluster_backend {
        label="Backend (Express.js)";
        style=filled;
        color=lightgrey;
        node [style=filled,color=white];
        
        Server [label="Express Server"];
        Routes [label="API Routes"];
        Middleware [label="Middleware\n(Validation, Error Handling)"];
        QRGenerator [label="QR Code Generator"];
        RecommendationEngine [label="Recommendation Engine"];
        
        Server -> Routes;
        Routes -> Middleware;
        Routes -> QRGenerator;
        Routes -> RecommendationEngine;
    }
    
    subgraph cluster_data {
        label="Data Layer";
        style=filled;
        color=lightgrey;
        node [style=filled,color=white];
        
        DB [label="Mock DB\n(db.json)"];
    }
    
    APIService -> Server [label="HTTP Requests"];
    Routes -> DB [label="Read/Write"];
    
    User [shape=circle];
    User -> Components [label="Interacts"];
}